# ===================================================================
# .gitignore para Proyecto HUV - Gestor de Oncología
# ===================================================================

# ===================================================================
# 🚨 BLOQUE CRÍTICO - DATOS MÉDICOS CONFIDENCIALES (Ley 1581)
# NUNCA subir datos de pacientes a ningún repositorio remoto.
# Estas reglas son OBLIGATORIAS y no deben eliminarse.
# ===================================================================

# Bases de datos (contienen datos de pacientes) - TODAS, en cualquier ruta
*.db
*.sqlite
*.sqlite3

# Backups (BD + JSON de respaldo con OCR y datos de pacientes)
backups/
**/backups/

# Salidas de extracción IA (datos de pacientes extraídos)
informes_ia/
informes_json/
debug_maps/

# Resultados exportados (Excel/CSV con datos de pacientes)
resultados_ihq/
*.xlsx
*.xls
*.csv

# PDFs de patología (datos médicos crudos)
pdfs_patologia/
*.pdf

# Comprimidos (suelen empaquetar BD/PDFs/proyecto completo y exceder 100MB)
*.rar
*.zip
*.7z

# Logs (pueden contener datos de pacientes y son pesados)
*.log

# Carpeta data (base de datos principal en producción)
data/

# Archivos temporales de sincronización (Google Drive, etc.)
.tmp.driveupload/
**/.tmp.driveupload/

# ===================================================================
# ENTORNO Y CACHE
# ===================================================================

# Entorno virtual
venv0/
venv/
.venv/

# Orquestador Claude (worktrees, config local)
.claude/

# Cache de Python
**/__pycache__/
**/*.pyc
**/*.pyo
*.py[cod]
*$py.class

# Compilación / distribución
**/build/
**/dist/
*.spec.bak

# LEGACY
LEGACY/
Legacy de bases de datos/

# Archivos de sistema (Windows/Mac)
.DS_Store
Thumbs.db
*.tmp
*.swp

# ===================================================================
# RESUMEN
# ===================================================================
# ✅ SE INCLUYE: código (.py), config/, core/, herramientas_ia/,
#    imagenes/, documentacion/ (.docx/.md), requirements.txt, .bat
# ❌ SE EXCLUYE (CRÍTICO): *.db, backups/, informes_ia/, pdfs_patologia/,
#    *.pdf, *.rar/.zip, *.log, *.xlsx/.csv, data/ → datos de pacientes
#    y archivos pesados. NUNCA quitar el bloque crítico de arriba.
# ===================================================================
